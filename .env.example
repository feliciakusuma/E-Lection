# Required database config (choose one style)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_PRIVATE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_PUBLIC_URL=postgresql://user:pass@host:5432/dbname

# Or PG* variables (Railway-compatible)
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=

# App/session security
SESSION_SECRET_KEY=change-me-to-a-strong-random-value
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE_SECONDS=14400
COOKIE_SAMESITE=lax

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_STUDENT_ID=2023000000

# ML-KEM (default now 512)
ENABLE_MLKEM=true
MLKEM_PARAM=ML-KEM-512

# Redis (recommended for session key ciphertext cache)
REDIS_URL=redis://localhost:6379/0
SESSION_KEY_TTL_SECONDS=0

# SMTP (optional but required for email verification flows)
EMAIL_SENDER=election.noreply@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=election.noreply@gmail.com
SMTP_PASSWORD=replace-with-app-password
SMTP_USE_TLS=true

# Gmail API (optional, preferred over SMTP when set)
# Requires OAuth client credentials + refresh token with Gmail send scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_API_USER=me
